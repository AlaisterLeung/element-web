.mx_MainSplit {
    display: flex;
    flex-direction: row;
    min-width: 0;
    min-height: 0;
    height: 100%;
}

.mx_MainSplit > .mx_RightPanel_ResizeWrapper {
    &:hover .mx_ResizeHandle--horizontal::before {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-150%, -50%);

        height: 64px; /* to match width of the ones on roomlist */
        width: 4px;
        border-radius: 4px;

        content: "";

        background-color: $primary-content;
        opacity: 0.8;
    }
}

.mx_MainSplit_overlay {
    /* Overlay mode: anchor the absolutely-positioned panel to this container. */
    position: relative;

    /* Clip the panel whenever it sits outside this box (closed state = translateX(100%),
       or mid-transition). Without this the off-screen panel inflates the document's
       scrollable overflow, so any focus() landing on it mid-slide auto-scrolls the
       whole window sideways until the transition ends. `clip` (not `hidden`) avoids
       creating a scroll container, and overflow-y stays visible. */
    overflow-x: clip;
}

.mx_MainSplit_overlay > .mx_RightPanel_ResizeWrapper {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    /* An overlay can never be wider than the room view: caps the 800px default
       (and any dragged width) on smaller viewports. */
    max-width: 100%;
    /* Above the scrim (11) and above in-timeline hover chrome (avatars/action
       bars sit at z-index 9) so nothing pokes through the overlay. */
    z-index: 12;
    overflow-y: auto;

    /* Slide out to the right edge when closed. */
    transform: translateX(100%);
    transition: transform 220ms cubic-bezier(0.4, 0, 0.2, 1);
    pointer-events: none;
}

.mx_RightPanel_open > .mx_RightPanel_ResizeWrapper {
    /* Visible: slide in, add shadow, allow interaction. */
    transform: translateX(0);
    pointer-events: auto;
    box-shadow: -30px 0 30px rgb(0 0 0 / 0.25);
}

.mx_MainSplit_overlay .mx_RightPanel_ResizeWrapper,
.mx_MainSplit_overlay .mx_RightPanel_scrim {
    transition: transform 220ms cubic-bezier(0.4, 0, 0.2, 1);
}

/* On very narrow room views the % setting is meaningless: the overlay covers the
   whole room view. RoomView already passes full width on narrow, this is a CSS
   fallback (matching the Measured 500px breakpoint) for any residual inline width. */
@media (max-width: 500px) {
    .mx_MainSplit_overlay > .mx_RightPanel_ResizeWrapper {
        width: 100% !important;
    }
}

.mx_MainSplit_overlay.mx_RightPanel_instant .mx_RightPanel_ResizeWrapper,
.mx_MainSplit_overlay.mx_RightPanel_instant .mx_RightPanel_scrim {
    /* Animation off (Labs setting): no slide/fade, instant open-close. */
    transition: none;
}

.mx_RightPanel_scrim {
    /* Dim the room behind the overlay; click closes. */
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    background-color: $dialog-backdrop-color;
    /* Above in-timeline hover chrome (EventTile avatars/action bars use z-index
       9) so hover overlays can't poke through the dim; below the panel (z12). */
    z-index: 11;
    pointer-events: none;
}

.mx_RightPanel_open > .mx_RightPanel_scrim {
    /* Visible: catch clicks, fully opaque. */
    pointer-events: auto;
    opacity: 1;
}

.mx_RightPanel_closed > .mx_RightPanel_scrim {
    /* Fade out with the closing slide; never block the room. */
    opacity: 0;
}

@media (prefers-reduced-motion: reduce) {
    .mx_MainSplit_overlay > .mx_RightPanel_ResizeWrapper,
    .mx_RightPanel_scrim {
        transition: none;
    }
}
